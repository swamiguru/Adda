# Absolute URL for OG images. Without it, share cards won't render.
NEXT_PUBLIC_SITE_URL=https://adda.builtbyswami.com

# Presence counter. Without this the counter simply doesn't render,
# which is a fine state for local dev and preview deploys.
#
# Provided automatically by Vercel Redis (project -> Storage tab).
# To run presence locally: vercel env pull .env.development.local
REDIS_URL=
